TIER_DEEP=cc:gpt-6.1-sol:medium:8192
TIER_GEMINI=gemini:gemini-3.8-flash:low:4096

HISTORY_MAX_MESSAGES=24
HISTORY_MAX_CHARS=24000
UPSTREAM_TIMEOUT_MS=120000
